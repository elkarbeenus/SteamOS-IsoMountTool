#!/usr/bin/env bash
# =============================================================================
#  SteamOS ISO Mount Tool
#  Mount and eject up to 4 ISO images on SteamOS (Desktop Mode) – no sudo needed.
#
#  Created by Dominic Lesina x Claude
#  https://github.com/elkarbeenus/SteamOS-IsoMountTool
# =============================================================================

set -u

APP_ID="steamos-isomounttool"
APP_NAME="SteamOS ISO Mount Tool"
REPO="elkarbeenus/SteamOS-IsoMountTool"
REPO_URL="https://github.com/${REPO}"
API_LATEST="https://api.github.com/repos/${REPO}/releases/latest"
MAX_ISOS=4

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# --- Version -----------------------------------------------------------------
APP_VERSION="0.0.0-dev"
for _vf in "$SCRIPT_DIR/../share/$APP_ID/VERSION" "$SCRIPT_DIR/../VERSION"; do
    if [[ -r "$_vf" ]]; then
        APP_VERSION="$(tr -d '[:space:]' < "$_vf")"
        break
    fi
done
unset _vf

# --- Paths (overridable for testing) -----------------------------------------
SYS_BLOCK="${ISOMOUNT_SYSBLOCK:-/sys/block}"
PROC_MOUNTS="${ISOMOUNT_PROC_MOUNTS:-/proc/mounts}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_ID"
CONFIG_FILE="$CONFIG_DIR/config"

# --- Settings (defaults) -----------------------------------------------------
UI_LANG=""
LANG_PREF=""      # explicitly chosen language (saved), empty = follow system
AUTO_UPDATE="1"
LAST_DIR="$HOME"

load_config() {
    [[ -r "$CONFIG_FILE" ]] || return 0
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            UI_LANG)     [[ "$value" == de || "$value" == en ]] && LANG_PREF="$value" ;;
            AUTO_UPDATE) [[ "$value" == 0 || "$value" == 1 ]] && AUTO_UPDATE="$value" ;;
            LAST_DIR)    [[ -n "$value" ]] && LAST_DIR="$value" ;;
        esac
    done < "$CONFIG_FILE"
}

save_config() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
    {
        printf 'UI_LANG=%s\n' "$LANG_PREF"
        printf 'AUTO_UPDATE=%s\n' "$AUTO_UPDATE"
        printf 'LAST_DIR=%s\n' "$LAST_DIR"
    } > "$CONFIG_FILE" 2>/dev/null || true
}

detect_lang() {
    if [[ -n "$LANG_PREF" ]]; then UI_LANG="$LANG_PREF"; return; fi
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        de*) UI_LANG="de" ;;
        *)   UI_LANG="en" ;;
    esac
}

